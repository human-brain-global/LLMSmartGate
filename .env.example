# LLMSmartGate -- Local Development Environment Variables
# Copy to .env and fill in values: cp .env.example .env

# ── Required ──
DATABASE_URL=postgres://llmsmartgate:llmsmartgate@localhost:5432/llmsmartgate
VALKEY_URL=redis://localhost:6379
LLMSMARTGATE_ADMIN_JWT_SECRET=change-me-in-production

# ── Optional (defaults shown) ──
LLMSMARTGATE_HOST=0.0.0.0
LLMSMARTGATE_PORT=8080
RUST_LOG=info
LLMSMARTGATE_PG_POOL_SIZE=20
LLMSMARTGATE_VALKEY_POOL_SIZE=10
LLMSMARTGATE_TIMESTAMP_SKEW_SECS=300
LLMSMARTGATE_PROVIDER_TIMEOUT_MS=30000

# ── Observability (optional) ──
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=llmsmartgate
